# Cloady deployment environment variables
# 请在 Cloady 控制台填写真实值，不要把真实卡密提交到 GitHub。

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# 主提取接口：填写接口地址本身，不要附加 ?km=
AOBI_EXTRACT_URL=
AOBI_KM=

# 备用提取接口（如未使用备用接口，可暂时留空）
AOBI_BACKUP_EXTRACT_URL=
AOBI_BACKUP_CARD_CODE=

# 数据库路径：Dockerfile 默认已设置为该路径
DB_NAME=/data/database.db
